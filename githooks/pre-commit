#!/bin/sh
# pm-cli pre-commit gate: formatting, vet, tests. Versioned in githooks/
# (git config core.hooksPath githooks). Fix the issue - never bypass with -n.
set -e
cd "$(git rev-parse --show-toplevel)"

unformatted=$(gofmt -l internal cmd 2>/dev/null)
if [ -n "$unformatted" ]; then
  echo "pre-commit: gofmt needed on:" >&2
  echo "$unformatted" >&2
  exit 1
fi

go vet ./... || { echo "pre-commit: go vet failed" >&2; exit 1; }
go test ./internal/... -count=1 || { echo "pre-commit: tests failed" >&2; exit 1; }
