#!/bin/sh
# pm-cli pre-commit gate: formatting, vet, staticcheck, tests. Versioned in
# githooks/ (git config core.hooksPath githooks). Fix the issue - never
# bypass with -n. Delegates to the Makefile so this hook, `make check` and
# the CI workflow never disagree on target sets.
set -e
cd "$(git rev-parse --show-toplevel)"

# Git exports GIT_DIR/GIT_INDEX_FILE/... into hooks; tests that spawn `git
# init` in temp dirs inherit them and explode (".git/index: Not a directory").
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_PREFIX

make check
