#!/bin/sh
# pm-cli pre-commit gate: formatting, vet, tests. Versioned in githooks/
# (git config core.hooksPath githooks). Fix the issue - never bypass with -n.
set -e
cd "$(git rev-parse --show-toplevel)"

# Git exports GIT_DIR/GIT_INDEX_FILE/... into hooks; tests that spawn `git
# init` in temp dirs inherit them and explode (".git/index: Not a directory").
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_PREFIX

unformatted=$(gofmt -l internal cmd 2>/dev/null)
if [ -n "$unformatted" ]; then
  echo "pre-commit: gofmt needed on:" >&2
  echo "$unformatted" >&2
  exit 1
fi

go vet ./... || { echo "pre-commit: go vet failed" >&2; exit 1; }

# staticcheck lives in GOBIN, which is often not on PATH inside hooks - resolve it.
STATICCHECK=$(command -v staticcheck 2>/dev/null || true)
if [ -z "$STATICCHECK" ]; then
  gobin=$(go env GOBIN)
  [ -n "$gobin" ] || gobin="$(go env GOPATH)/bin"
  STATICCHECK="$gobin/staticcheck"
fi
if [ ! -x "$STATICCHECK" ]; then
  echo "pre-commit: staticcheck not found - run: go install honnef.co/go/tools/cmd/staticcheck@latest" >&2
  exit 1
fi
"$STATICCHECK" ./... || { echo "pre-commit: staticcheck failed" >&2; exit 1; }

go test ./internal/... -count=1 || { echo "pre-commit: tests failed" >&2; exit 1; }
